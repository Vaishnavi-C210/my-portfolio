# Port the server will listen on
PORT=5000

# MongoDB Atlas connection string. 
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?<options>
# NOTE: If your password contains special characters (e.g. @, :, /, or ?), you MUST URL-encode them.
# Example: '@' becomes '%40', '/' becomes '%2F'
MONGODB_URI=mongodb+srv://root:<password>@portfolioapp.odq7hf1.mongodb.net/portfolio?appName=PortfolioApp
